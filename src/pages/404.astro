---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Página não encontrada | KZ × ROLEX"
	description="A página que você procura não foi encontrada. Volte ao início ou explore a coleção conceitual KZ × ROLEX."
>
	<main class="not-found" aria-labelledby="not-found-title">
		<p class="not-found__eyebrow">KZ × ROLEX · ESTUDO VISUAL NÃO OFICIAL</p>
		<span class="not-found__code" aria-hidden="true">404</span>
		<h1 id="not-found-title">Esta página não está <em>na coleção.</em></h1>
		<p class="not-found__message">O endereço pode ter mudado ou não existir. Você pode voltar ao início ou conhecer as edições disponíveis.</p>
		<nav class="not-found__actions" aria-label="Navegação de recuperação">
			<a class="not-found__primary" href="/catalogo">Explorar a coleção <span aria-hidden="true">↗</span></a>
			<a class="not-found__secondary" href="/">Voltar ao início</a>
		</nav>
	</main>
</Layout>

<style>
	.not-found { position: relative; display: grid; justify-items: center; min-height: min(680px, 76svh); align-content: center; overflow: hidden; padding: 80px 24px; color: #f2eee7; text-align: center; background: radial-gradient(ellipse at 50% 44%, rgba(200,169,126,.11), transparent 56%); }
	.not-found__eyebrow { z-index: 1; margin: 0 0 20px; color: #c8a97e; font: 10px var(--font-mono); letter-spacing: .22em; }
	.not-found__code { position: absolute; top: 50%; left: 50%; color: rgba(200,169,126,.045); font: 400 clamp(240px, 43vw, 560px)/.8 var(--font-display); transform: translate(-50%, -50%); pointer-events: none; }
	.not-found h1 { z-index: 1; max-width: 760px; margin: 0; font: 400 clamp(42px, 7vw, 84px)/1.02 var(--font-display); text-transform: uppercase; }
	.not-found h1 em { color: #c8a97e; font: italic 400 1em/.98 var(--font-serif); text-transform: none; }
	.not-found__message { z-index: 1; max-width: 460px; margin: 22px 0 30px; color: #b9b0a3; font-size: 14px; line-height: 1.8; }
	.not-found__actions { z-index: 1; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 24px; }
	.not-found__primary, .not-found__secondary { color: #f2eee7; font-size: 10px; letter-spacing: .15em; text-decoration: none; text-transform: uppercase; }
	.not-found__primary { display: inline-flex; align-items: center; gap: 22px; padding: 16px 22px; border: 1px solid rgba(200,169,126,.55); background: linear-gradient(110deg, rgba(200,169,126,.14), rgba(200,169,126,.035)); }
	.not-found__primary span { color: #c8a97e; font-size: 16px; }
	.not-found__secondary { padding: 12px 0; border-bottom: 1px solid rgba(200,169,126,.45); }
	.not-found a:focus-visible { outline: 2px solid #fff0d0; outline-offset: 5px; }
	@media (max-width: 700px) { .not-found { min-height: 65svh; padding: 64px 22px; } .not-found__eyebrow { font-size: 8px; letter-spacing: .13em; } .not-found__message { max-width: 340px; font-size: 13px; } .not-found__actions { gap: 12px 20px; } }
</style>
