---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { products } from '../data/products';
import { getImage, Image } from 'astro:assets';

const materialJourneys = [
	{ title: 'Ouro & lapidação', detail: 'Pedras · ouro polido', count: '03 edições', product: products[0] },
	{ title: 'Noir técnico', detail: 'Preto · carbono', count: '02 edições', product: products[2] },
	{ title: 'Reflexos & metais', detail: 'Titânio · safira · madrepérola', count: '04 edições', product: products[3] },
];
const materialOptions = await Promise.all(materialJourneys.map(async (journey) => ({
	...journey,
	imageSrc: (await getImage({ src: journey.product.image, width: 900, format: 'webp' })).src,
})));
const initialJourney = materialOptions[0];
---

<Layout
	title="Coleção KZ × ROLEX — Conceito visual não oficial"
	description="Nove edições em um estudo visual não oficial KZ × ROLEX; os acabamentos e valores são conceituais e ilustrativos."
	image={products[2].image}
>
	<main class="catalog-page">
		<header class="catalog-heading">
			<p class="eyebrow">KZ × ROLEX · CONCEITO VISUAL NÃO OFICIAL</p>
			<h1>Nove maneiras<br /><em>de ouvir com estilo.</em></h1>
			<p>Acabamentos distintos, da joalheria dourada à precisão do titânio. Encontre a edição que combina com a sua escuta.</p>
		</header>

		<section class="material-discovery" aria-labelledby="material-discovery-title">
			<header class="material-discovery-intro">
				<p class="eyebrow">A COLEÇÃO · 09 EDIÇÕES</p>
				<h2 id="material-discovery-title">Escolha sua<br /><em>assinatura.</em></h2>
				<p>Três atmosferas visuais. Encontre a matéria que combina com a sua escuta.</p>
			</header>
			<div class="material-selector" data-material-selector>
				<div class="material-choices" role="group" aria-label="Escolha um acabamento">
					{materialOptions.map((journey, index) => (
						<button
							type="button"
							class:list={['material-choice', { 'is-selected': index === 0 }]}
							data-material-choice
							data-title={journey.title}
							data-count={journey.count}
							data-name={journey.product.name}
							data-finish={journey.product.finish}
							data-description={journey.product.description}
							data-image={journey.imageSrc}
							data-alt={journey.product.alt}
							data-slug={journey.product.slug}
							aria-pressed={index === 0 ? 'true' : 'false'}
						>
							<span>0{index + 1}</span>
							<strong>{journey.title}</strong>
							<small>{journey.detail}</small>
						</button>
					))}
				</div>
				<div class="material-stage" data-material-stage>
					<a class="material-stage-image finish-sheen" data-material-detail href={`/produtos/${initialJourney.product.slug}`} aria-label={`Conheça ${initialJourney.product.name}`}>
						<Image data-material-image src={initialJourney.product.image} alt={initialJourney.product.alt} layout="constrained" sizes="(max-width: 700px) calc(100vw - 32px), 45vw" width={900} height={900} />
						<span aria-hidden="true">↗</span>
					</a>
					<div class="material-stage-copy" aria-live="polite" aria-atomic="true">
						<p class="material-stage-count" data-material-count>{initialJourney.count}</p>
						<p class="material-stage-title" data-material-title>{initialJourney.title}</p>
						<h3 data-material-name>{initialJourney.product.name}</h3>
						<p class="material-stage-finish" data-material-finish>{initialJourney.product.finish}</p>
						<p class="material-stage-description" data-material-description>{initialJourney.product.description}</p>
						<a class="material-route" data-material-route href={`#product-${initialJourney.product.slug}`}>Encontrar no catálogo <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</div>
		</section>

		<ProductGrid showHeading={false} compact={true} />
	</main>

</Layout>

<style>
	.catalog-page { padding-top: 112px; }
	.catalog-heading { width: min(100% - 64px, 1440px); margin: 0 auto; padding: 32px 0 26px; border-bottom: 1px solid var(--border-gold-subtle); }
	.eyebrow { margin: 0 0 18px; color: var(--gold-light); font: 10px var(--font-mono); letter-spacing: .22em; }
	.catalog-heading h1 { margin: 0; color: var(--text-bone); font: 400 clamp(42px, 5.7vw, 72px)/.98 var(--font-display); text-transform: uppercase; }
	.catalog-heading h1 em { color: var(--gold-light); font: italic 400 1em var(--font-serif); text-transform: none; }
	.catalog-heading > p:last-child { max-width: 560px; margin: 14px 0 0; color: var(--text-sand); font-size: 14px; line-height: 1.75; }
	.material-discovery { display: grid; grid-template-columns: .7fr 1.3fr; align-items: center; gap: clamp(36px, 7vw, 96px); width: min(100% - 64px, 1240px); margin: 0 auto; padding: 42px 0 46px; border-bottom: 1px solid var(--border-gold-subtle); color: var(--text-bone); }
	.material-discovery-intro .eyebrow { margin-bottom: 14px; }
	.material-discovery-intro h2 { margin: 0; font: 400 clamp(38px, 4.2vw, 54px)/.98 var(--font-display); }
	.material-discovery-intro h2 em { color: var(--gold-light); font: italic 400 1em/.98 var(--font-serif); }
	.material-discovery-intro > p:last-child { max-width: 340px; margin: 14px 0 0; color: var(--text-sand); font-size: 13px; line-height: 1.7; }
	.material-selector { min-width: 0; }
	.material-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 16px; border-top: 1px solid var(--border-gold-subtle); border-bottom: 1px solid var(--border-gold-subtle); }
	.material-choice { display: grid; align-content: start; gap: 7px; min-height: 94px; padding: 14px 12px 12px; border: 0; border-right: 1px solid var(--border-gold-subtle); background: transparent; color: var(--text-sand); text-align: left; cursor: pointer; transition: background-color .25s ease, color .25s ease, box-shadow .35s ease; }
	.material-choice:last-child { border-right: 0; }
	.material-choice:hover, .material-choice.is-selected { background: linear-gradient(180deg, rgba(200,169,126,.1), transparent); color: var(--text-bone); }
	.material-choice.is-selected { box-shadow: inset 0 2px var(--gold-primary); }
	.material-choice:focus-visible { position: relative; z-index: 1; outline: 2px solid var(--gold-light); outline-offset: 2px; }
	.material-choice > span, .material-stage-count { color: var(--gold-light); font: 9px var(--font-mono); letter-spacing: .12em; }
	.material-choice strong { font: 400 clamp(17px, 1.65vw, 23px)/1.05 var(--font-display); }
	.material-choice small { overflow: hidden; color: var(--text-muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
	.material-stage { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: clamp(20px, 3vw, 42px); }
	.material-stage-image { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: #090807; color: var(--gold-light); }
	.material-stage-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease-luxury); }
	.material-stage-image:hover img { transform: scale(1.025); }
	.material-stage.is-transitioning .material-stage-image img { animation: finish-image-reveal .72s cubic-bezier(.2,.7,.2,1) both; }
	.material-stage.is-transitioning .material-stage-copy > * { animation: finish-copy-reveal .48s cubic-bezier(.2,.7,.2,1) both; }
	.material-stage.is-transitioning .material-stage-copy > :nth-child(2) { animation-delay: 45ms; }
	.material-stage.is-transitioning .material-stage-copy > :nth-child(3) { animation-delay: 90ms; }
	.material-stage.is-transitioning .material-stage-copy > :nth-child(4) { animation-delay: 135ms; }
	.material-stage.is-transitioning .material-stage-copy > :nth-child(5) { animation-delay: 180ms; }
	.material-stage.is-transitioning .material-stage-copy > :nth-child(6) { animation-delay: 225ms; }
	@keyframes finish-image-reveal { from { opacity: .58; filter: blur(3px); transform: scale(1.035); } to { opacity: 1; filter: blur(0); transform: scale(1); } }
	@keyframes finish-copy-reveal { from { opacity: .35; transform: translateY(9px); } to { opacity: 1; transform: translateY(0); } }
	.material-stage-image > span { position: absolute; right: 12px; bottom: 10px; display: grid; width: 32px; height: 32px; place-items: center; border: 1px solid rgba(232,178,90,.55); background: rgba(5,5,5,.56); }
	.material-stage-copy { min-width: 0; }
	.material-stage-copy p { margin: 0; }
	.material-stage-count { margin-bottom: 8px !important; text-transform: uppercase; }
	.material-stage-title { color: var(--text-muted); font: 10px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
	.material-stage-copy h3 { margin: 6px 0 0; color: var(--text-bone); font: 400 clamp(26px, 3vw, 38px)/1.05 var(--font-display); }
	.material-stage-finish { margin-top: 9px !important; color: var(--gold-light); font: 10px/1.5 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
	.material-stage-description { margin-top: 14px !important; color: var(--text-sand); font-size: 12px; line-height: 1.7; }
	.material-route { display: inline-flex; align-items: center; gap: 14px; margin-top: 17px; padding: 10px 0; border-bottom: 1px solid var(--gold-dark); color: var(--text-bone); font-size: 10px; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
	.material-route span { color: var(--gold-light); font-size: 15px; }
	.material-route:hover { color: var(--gold-light); }
	.material-route:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 4px; }
	@media (max-width: 700px) {
		.material-discovery { grid-template-columns: 1fr; gap: 24px; width: min(100% - 32px, 1240px); padding: 30px 0 34px; }
		.material-discovery-intro .eyebrow { margin-bottom: 10px; }
		.material-discovery-intro h2 { font-size: clamp(36px, 9vw, 46px); }
		.material-discovery-intro > p:last-child { max-width: 340px; margin-top: 10px; font-size: 12px; }
		.material-choices { gap: 0; margin-bottom: 12px; }
		.material-choice { min-height: 88px; gap: 6px; padding: 12px 8px 10px; }
		.material-choice strong { font-size: clamp(15px, 4vw, 19px); }
		.material-choice small { font-size: 8px; }
		.material-stage { grid-template-columns: 1fr; gap: 18px; }
		.material-stage-copy h3 { font-size: 32px; }
		.material-stage-description { max-width: 480px; }
	}
	@media (max-width: 600px) { .catalog-page { padding-top: 100px; } .catalog-heading { width: min(100% - 32px, 1440px); padding: 22px 0 18px; } .catalog-heading h1 { font-size: clamp(36px, 10vw, 54px); } .catalog-heading > p:last-child { margin-top: 12px; font-size: 13px; } }
	@media (prefers-reduced-motion: reduce) { .material-choice, .material-stage-image img { transition: none; } .material-stage.is-transitioning .material-stage-image img, .material-stage.is-transitioning .material-stage-copy > * { animation: none; } }
</style>
