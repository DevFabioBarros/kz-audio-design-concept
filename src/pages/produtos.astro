---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { products } from '../data/products';

const materialJourneys = [
	{ title: 'Ouro & lapidação', detail: 'Pedras · ouro polido', count: '03 edições', product: products[0] },
	{ title: 'Noir técnico', detail: 'Preto · carbono', count: '02 edições', product: products[2] },
	{ title: 'Reflexos & metais', detail: 'Titânio · safira · madrepérola', count: '04 edições', product: products[3] },
];
---

<Layout
	title="Coleção KZ × ROLEX — Conceito visual não oficial"
	description="Nove edições em um estudo visual não oficial KZ × ROLEX; os acabamentos e valores são conceituais e ilustrativos."
>
	<main class="catalog-page">
		<header class="catalog-heading">
			<p class="eyebrow">KZ × ROLEX · CONCEITO VISUAL NÃO OFICIAL</p>
			<h1>Nove maneiras<br /><em>de ouvir com estilo.</em></h1>
			<p>Acabamentos distintos, da joalheria dourada à precisão do titânio. Encontre a edição que combina com a sua escuta.</p>
		</header>

		<section class="material-discovery" aria-labelledby="material-discovery-title">
			<header class="material-discovery-intro">
				<p class="eyebrow">A COLEÇÃO · 09 EDIÇÕES</p>
				<h2 id="material-discovery-title">Escolha sua<br /><em>assinatura.</em></h2>
				<p>Três atmosferas visuais. Encontre a matéria que combina com a sua escuta.</p>
			</header>
			<nav class="material-discovery-links" aria-label="Explore as edições por acabamento">
				{materialJourneys.map((journey) => (
					<a class="material-route" href={`#product-${journey.product.slug}`} aria-label={`Explorar ${journey.count} de ${journey.title}, começando por ${journey.product.name}`}>
						<img src={journey.product.image} alt="" loading="lazy" />
						<span class="material-route-copy">
							<span class="material-route-detail">{journey.detail}</span>
							<strong>{journey.title}</strong>
							<span class="material-route-count">{journey.count}</span>
						</span>
						<span class="material-route-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</nav>
		</section>

		<ProductGrid showHeading={false} compact={true} />
	</main>

</Layout>

<style>
	.catalog-page { padding-top: 112px; }
	.catalog-heading { width: min(100% - 64px, 1440px); margin: 0 auto; padding: 32px 0 26px; border-bottom: 1px solid var(--border-gold-subtle); }
	.eyebrow { margin: 0 0 18px; color: var(--gold-light); font: 10px var(--font-mono); letter-spacing: .22em; }
	.catalog-heading h1 { margin: 0; color: var(--text-bone); font: 400 clamp(42px, 5.7vw, 72px)/.98 var(--font-display); text-transform: uppercase; }
	.catalog-heading h1 em { color: var(--gold-light); font: italic 400 1em var(--font-serif); text-transform: none; }
	.catalog-heading > p:last-child { max-width: 560px; margin: 14px 0 0; color: var(--text-sand); font-size: 14px; line-height: 1.75; }
	.material-discovery { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: clamp(36px, 7vw, 96px); width: min(100% - 64px, 1240px); margin: 0 auto; padding: 34px 0 38px; border-bottom: 1px solid var(--border-gold-subtle); color: var(--text-bone); }
	.material-discovery-intro .eyebrow { margin-bottom: 14px; }
	.material-discovery-intro h2 { margin: 0; font: 400 clamp(38px, 4.2vw, 54px)/.98 var(--font-display); }
	.material-discovery-intro h2 em { color: var(--gold-light); font: italic 400 1em/.98 var(--font-serif); }
	.material-discovery-intro > p:last-child { max-width: 340px; margin: 14px 0 0; color: var(--text-sand); font-size: 13px; line-height: 1.7; }
	.material-discovery-links { display: grid; gap: 8px; }
	.material-route { display: grid; grid-template-columns: 78px minmax(0, 1fr) 44px; align-items: center; gap: 18px; min-height: 88px; padding: 6px 10px 6px 6px; border: 1px solid var(--border-gold-subtle); background: linear-gradient(100deg, rgba(200,169,126,.035), transparent 55%); color: inherit; text-decoration: none; transition: border-color .25s ease, background-color .25s ease; }
	.material-route:hover, .material-route:focus-visible { border-color: var(--gold-primary); background-color: rgba(200,169,126,.055); }
	.material-route:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 3px; }
	.material-route img { display: block; width: 78px; height: 74px; object-fit: cover; }
	.material-route-copy { display: flex; min-width: 0; flex-direction: column; gap: 3px; }
	.material-route-detail, .material-route-count { color: var(--text-muted); font: 9px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.material-route-copy strong { color: var(--text-bone); font: 400 23px/1.05 var(--font-display); transition: color .2s ease; }
	.material-route:hover .material-route-copy strong, .material-route:focus-visible .material-route-copy strong { color: var(--gold-light); }
	.material-route-count { font-size: 8px; }
	.material-route-arrow { display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid var(--border-gold-subtle); border-radius: 50%; color: var(--gold-light); font-size: 17px; transition: background-color .25s ease; }
	.material-route:hover .material-route-arrow, .material-route:focus-visible .material-route-arrow { background: rgba(200,169,126,.12); }
	@media (max-width: 700px) {
		.material-discovery { grid-template-columns: 1fr; gap: 22px; width: min(100% - 32px, 1240px); padding: 28px 0 30px; }
		.material-discovery-intro .eyebrow { margin-bottom: 10px; }
		.material-discovery-intro h2 { font-size: clamp(36px, 9vw, 46px); }
		.material-discovery-intro > p:last-child { max-width: 340px; margin-top: 10px; font-size: 12px; }
		.material-discovery-links { gap: 7px; }
		.material-route { grid-template-columns: 68px minmax(0, 1fr) 36px; gap: 12px; min-height: 78px; padding: 5px 8px 5px 5px; }
		.material-route img { width: 68px; height: 66px; }
		.material-route-copy strong { font-size: 20px; }
		.material-route-detail { font-size: 8px; }
		.material-route-count { font-size: 7px; }
		.material-route-arrow { width: 34px; height: 34px; }
	}
	@media (max-width: 600px) { .catalog-page { padding-top: 100px; } .catalog-heading { width: min(100% - 32px, 1440px); padding: 22px 0 18px; } .catalog-heading h1 { font-size: clamp(36px, 10vw, 54px); } .catalog-heading > p:last-child { margin-top: 12px; font-size: 13px; } }
	@media (prefers-reduced-motion: reduce) { .material-route, .material-route-copy strong, .material-route-arrow { transition: none; } }
</style>
