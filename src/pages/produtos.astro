---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { products } from '../data/products';
---

<Layout
	title="Coleção KZ × ROLEX — Conceito visual não oficial"
	description="Nove edições em um estudo visual não oficial KZ × ROLEX; os acabamentos e valores são conceituais e ilustrativos."
>
	<main class="catalog-page">
		<header class="catalog-heading">
			<p class="eyebrow">KZ × ROLEX · CONCEITO VISUAL NÃO OFICIAL</p>
			<h1>Nove maneiras<br /><em>de ouvir com estilo.</em></h1>
			<p>Acabamentos distintos, da joalheria dourada à precisão do titânio. Encontre a edição que combina com a sua escuta.</p>
		</header>

		<section class="edition-index" data-edition-index aria-labelledby="edition-index-title">
			<header class="edition-index-heading">
				<div>
					<p class="eyebrow">PERCURSO DA COLEÇÃO · 09 EDIÇÕES</p>
					<h2 id="edition-index-title">Encontre o seu<br /><em>acabamento.</em></h2>
				</div>
				<p>Da madrepérola ao titânio. Selecione uma edição para ir direto à peça.</p>
			</header>
			<nav class="edition-index-window" aria-label="Acesso direto às edições">
				<div class="edition-index-rail" data-edition-rail>
					<div class="edition-index-group">
						{products.map((product, index) => (
							<a class="edition-index-item" href={`#product-${product.slug}`} aria-label={`Ir para ${product.name}, acabamento ${product.finish}`}>
								<span class="edition-index-number">{String(index + 1).padStart(2, '0')} / 09</span>
								<strong>{product.name}</strong>
								<span class="edition-index-finish">{product.finish}</span>
							</a>
						))}
					</div>
					<div class="edition-index-group" data-edition-duplicate aria-hidden="true" hidden>
						{products.map((product, index) => (
							<a class="edition-index-item" href={`#product-${product.slug}`} tabindex="-1">
								<span class="edition-index-number">{String(index + 1).padStart(2, '0')} / 09</span>
								<strong>{product.name}</strong>
								<span class="edition-index-finish">{product.finish}</span>
							</a>
						))}
					</div>
				</div>
			</nav>
			<div class="edition-index-controls">
				<p class="edition-index-hint" aria-hidden="true">EDIÇÕES · SELECIONE PARA VER OS DETALHES</p>
				<button class="edition-index-toggle" data-edition-toggle type="button" aria-pressed="false" hidden>Pausar movimento</button>
			</div>
		</section>

		<ProductGrid showHeading={false} compact={true} />
	</main>

	<script src="../scripts/edition-index.js"></script>
</Layout>

<style>
	.catalog-page { padding-top: 112px; }
	.catalog-heading { width: min(100% - 64px, 1440px); margin: 0 auto; padding: 32px 0 26px; border-bottom: 1px solid var(--border-gold-subtle); }
	.eyebrow { margin: 0 0 18px; color: var(--gold-light); font: 10px var(--font-mono); letter-spacing: .22em; }
	.catalog-heading h1 { margin: 0; color: var(--text-bone); font: 400 clamp(42px, 5.7vw, 72px)/.98 var(--font-display); text-transform: uppercase; }
	.catalog-heading h1 em { color: var(--gold-light); font: italic 400 1em var(--font-serif); text-transform: none; }
	.catalog-heading > p:last-child { max-width: 560px; margin: 14px 0 0; color: var(--text-sand); font-size: 14px; line-height: 1.75; }
	.edition-index { width: min(100% - 64px, 1240px); margin: 0 auto; padding: 42px 0 18px; border-bottom: 1px solid var(--border-gold-subtle); color: var(--text-bone); }
	.edition-index-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 26px; }
	.edition-index-heading .eyebrow { margin-bottom: 12px; }
	.edition-index-heading h2 { margin: 0; font: 400 clamp(34px, 4.4vw, 56px)/.98 var(--font-display); }
	.edition-index-heading h2 em { color: var(--gold-light); font: italic 400 1em/.98 var(--font-serif); }
	.edition-index-heading > p { max-width: 280px; margin: 0 0 4px; color: var(--text-sand); font-size: 12px; line-height: 1.7; }
	.edition-index-window { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--gold-dark) transparent; }
	.edition-index-window.is-moving { overflow: hidden; }
	.edition-index-rail, .edition-index-group { display: flex; width: max-content; gap: 0; }
	.edition-index-item { display: flex; flex: 0 0 clamp(205px, 20vw, 250px); flex-direction: column; min-height: 112px; padding: 4px 26px 8px; border-left: 1px solid var(--border-gold-subtle); color: inherit; text-decoration: none; transition: color .2s ease; }
	.edition-index-item:last-child { border-right: 1px solid var(--border-gold-subtle); }
	.edition-index-number { margin-bottom: 14px; color: var(--gold-primary); font: 9px var(--font-mono); letter-spacing: .13em; }
	.edition-index-item strong { overflow: hidden; color: var(--text-bone); font: 400 22px/1.1 var(--font-display); text-overflow: ellipsis; white-space: nowrap; transition: color .2s ease; }
	.edition-index-finish { margin-top: 7px; color: var(--text-muted); font-size: 10px; line-height: 1.45; }
	.edition-index-item:hover strong, .edition-index-item:focus-visible strong { color: var(--gold-light); }
	.edition-index-item:focus-visible { outline: 2px solid var(--gold-light); outline-offset: -2px; }
	.edition-index-controls { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 10px; }
	.edition-index-hint { margin: 0; color: var(--text-muted); font: 8px var(--font-mono); letter-spacing: .14em; }
	.edition-index-toggle { min-height: 44px; padding: 0 14px; border: 1px solid var(--border-gold-subtle); border-radius: 2px; background: transparent; color: var(--text-sand); font: 9px var(--font-mono); letter-spacing: .1em; cursor: pointer; }
	.edition-index-toggle:hover, .edition-index-toggle:focus-visible { border-color: var(--gold-primary); color: var(--gold-light); }
	.edition-index-rail { will-change: transform; }
	@media (max-width: 700px) {
		.edition-index { width: min(100% - 32px, 1240px); padding: 30px 0 14px; }
		.edition-index-heading { align-items: start; flex-direction: column; gap: 12px; margin-bottom: 18px; }
		.edition-index-heading h2 { font-size: clamp(34px, 8vw, 46px); }
		.edition-index-heading > p { max-width: 360px; }
		.edition-index-item { flex-basis: min(74vw, 260px); min-height: 104px; padding-inline: 18px; }
		.edition-index-hint { font-size: 7px; letter-spacing: .1em; }
		.edition-index-toggle { padding-inline: 10px; font-size: 8px; }
	}
	@media (max-width: 600px) { .catalog-page { padding-top: 100px; } .catalog-heading { width: min(100% - 32px, 1440px); padding: 22px 0 18px; } .catalog-heading h1 { font-size: clamp(36px, 10vw, 54px); } .catalog-heading > p:last-child { margin-top: 12px; font-size: 13px; } }
	@media (prefers-reduced-motion: reduce) { .edition-index-item, .edition-index-item strong { transition: none; } }
</style>
