---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import { Image } from 'astro:assets';

export function getStaticPaths() {
	return products.map((product, index) => ({
		params: { slug: product.slug },
		props: {
			product,
			previousProduct: products[(index - 1 + products.length) % products.length],
			nextProduct: products[(index + 1) % products.length],
		},
	}));
}

const { product, previousProduct, nextProduct } = Astro.props;
const isConcept = product.status === 'Conceito';
---

<Layout
	title={`${product.name} — KZ × ROLEX, conceito visual não oficial`}
	description={`${product.description} ${product.finish}. Estudo visual não oficial; valores e disponibilidade devem ser confirmados.`}
	image={product.image}
>
	<main class="product-detail">
		<nav class="breadcrumbs" aria-label="Você está em">
			<a href="/">Início</a><span aria-hidden="true">/</span><a href="/produtos">Coleção</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span>
		</nav>

		<section class="detail-layout" aria-labelledby="product-title">
			<figure class="detail-image finish-sheen reveal">
				<Image src={product.image} alt={product.alt} layout="constrained" sizes="(max-width: 900px) calc(100vw - 40px), 46vw" width={1254} height={1254} loading="eager" fetchpriority="high" />
				<figcaption>KZ × ROLEX · ESTUDO VISUAL NÃO OFICIAL</figcaption>
			</figure>

			<div class="detail-copy reveal">
				<p class="detail-kicker">EDIÇÃO {String(products.indexOf(product) + 1).padStart(2, '0')} / 09</p>
				<p class="detail-status" class:is-concept={isConcept}>{product.status}</p>
				<h1 id="product-title">{product.name}</h1>
				<p class="detail-description">{product.description}</p>
				<dl class="detail-dossier" aria-label="Ficha da edição">
					<div><dt>Acabamento</dt><dd>{product.finish}</dd></div>
					<div><dt>Valor ilustrativo</dt><dd class="dossier-price">{product.price} <small>USD</small></dd></div>
					<div><dt>Status da edição</dt><dd>{product.status}</dd></div>
				</dl>

				<p class="detail-disclaimer">
					{isConcept
						? 'Este produto é um conceito visual e não está confirmado para venda.'
						: 'Conceito visual não oficial. Confirme disponibilidade e especificações antes de qualquer decisão de compra.'}
				</p>

				<a class="back-to-collection" href="/produtos">Voltar à coleção <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="contact-request" aria-labelledby="contact-title" data-contact-prototype>
			<div class="contact-intro">
				<p class="detail-kicker">ATENDIMENTO PRIVÉ</p>
				<h2 id="contact-title">Insira seus dados<br /><em>para contato.</em></h2>
				<p>Conte como prefere ser atendido. Em uma versão funcional, sua solicitação seria encaminhada ao e-mail da empresa.</p>
			</div>
			<div class="contact-fields" role="form" aria-label="Solicitação de contato — protótipo">
				<label>Nome<input name="name" autocomplete="name" required placeholder="Seu nome" /></label>
				<label>E-mail<input name="email" type="email" autocomplete="email" required placeholder="voce@exemplo.com" /></label>
				<label>Telefone <span>(opcional)</span><input name="phone" type="tel" autocomplete="tel" placeholder="(00) 00000-0000" /></label>
				<label>Prefere contato por
					<select name="contact-preference">
						<option value="email">E-mail</option>
						<option value="phone">Telefone ou WhatsApp</option>
					</select>
				</label>
				<label class="contact-message">Mensagem <span>(opcional)</span><textarea name="message" rows="3" placeholder="Como podemos ajudar?"></textarea></label>
				<div class="contact-submit">
					<button type="button" data-contact-submit>Solicitar contato <span aria-hidden="true">↗</span></button>
					<p>Protótipo: os dados não são enviados nem armazenados.</p>
					<p class="contact-status" data-contact-status role="status" aria-live="polite"></p>
				</div>
			</div>
		</section>

		<nav class="detail-pagination" aria-label="Outras edições">
			<a href={`/produtos/${previousProduct.slug}`}><span>EDIÇÃO ANTERIOR</span><strong>← {previousProduct.name}</strong></a>
			<a href={`/produtos/${nextProduct.slug}`}><span>PRÓXIMA EDIÇÃO</span><strong>{nextProduct.name} →</strong></a>
		</nav>
	</main>
</Layout>

<style>
	.product-detail { width: min(100% - 64px, 1320px); margin: 0 auto; padding: 150px 0 90px; color: var(--text-bone); }
	.breadcrumbs { display: flex; flex-wrap: wrap; gap: 11px; margin: 0 0 28px; color: var(--text-muted); font-size: 11px; }
	.breadcrumbs a { color: var(--text-sand); text-decoration: none; }
	.breadcrumbs a:hover { color: var(--gold-light); }
	.detail-layout { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(340px, .88fr); align-items: center; gap: clamp(40px, 7vw, 100px); }
	.detail-image { position: relative; overflow: hidden; margin: 0; background: #090807; }
	.detail-image img { display: block; width: 100%; max-height: 720px; aspect-ratio: 1; object-fit: contain; }
	.detail-image figcaption { position: absolute; right: 18px; bottom: 16px; color: #f2eee7; font: 9px var(--font-mono); letter-spacing: .14em; text-shadow: 0 1px 8px #000; }
	.detail-copy { max-width: 510px; }
	.detail-kicker, .detail-status { margin: 0 0 12px; color: #9fb9a9; font: 10px var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.detail-status { display: inline-block; margin: 0 0 20px; padding: 6px 9px; border: 1px solid rgba(159,185,169,.35); color: #b8c9bc; letter-spacing: .08em; }
	.detail-status.is-concept { color: #c9a889; border-color: rgba(201,168,137,.4); }
	.detail-copy h1 { margin: 0; font: 400 clamp(46px, 6vw, 76px)/.98 var(--font-display); letter-spacing: .02em; }
	.detail-description { max-width: 440px; margin: 28px 0; color: var(--text-sand); font: 15px/1.8 var(--font-sans); }
	.detail-dossier { margin: 28px 0; border-top: 1px solid var(--border-gold-subtle); }
	.detail-dossier > div { display: grid; grid-template-columns: minmax(105px, .7fr) 1.3fr; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border-gold-subtle); }
	.detail-dossier dt { color: var(--text-muted); font: 9px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.detail-dossier dd { margin: 0; color: var(--text-bone); font-size: 12px; line-height: 1.5; text-align: right; }
	.detail-dossier .dossier-price { color: var(--gold-pale); font: 500 18px var(--font-mono); }
	.detail-dossier .dossier-price small { color: var(--text-muted); font-size: 9px; }
	.detail-disclaimer { margin: 18px 0 25px; color: var(--text-muted); font-size: 11px; line-height: 1.7; }
	.contact-request { display: grid; grid-template-columns: minmax(240px, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 7vw, 100px); margin-top: 88px; padding: clamp(26px, 5vw, 64px); border: 1px solid rgba(200,169,126,.22); background: linear-gradient(140deg, rgba(200,169,126,.07), rgba(255,255,255,.015)); }
	.contact-intro h2 { margin: 0 0 18px; color: var(--text-bone); font: 400 clamp(34px, 4vw, 52px)/1 var(--font-display); }
	.contact-intro h2 em { color: var(--gold-light); font: italic 400 1em var(--font-serif); }
	.contact-intro > p:last-child { max-width: 360px; color: var(--text-sand); font-size: 13px; line-height: 1.8; }
	.contact-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 16px; }
	.contact-fields label { display: grid; gap: 8px; color: var(--text-sand); font: 10px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.contact-fields label span { display: inline; color: var(--text-muted); font: inherit; text-transform: none; }
	.contact-fields input, .contact-fields select, .contact-fields textarea { width: 100%; box-sizing: border-box; padding: 13px 14px; border: 1px solid rgba(200,169,126,.25); border-radius: 2px; background: rgba(5,5,5,.4); color: var(--text-bone); font: 13px var(--font-sans); letter-spacing: normal; text-transform: none; }
	.contact-fields input::placeholder, .contact-fields textarea::placeholder { color: #857d72; }
	.contact-fields select { color-scheme: dark; }
	.contact-fields textarea { resize: vertical; }
	.contact-fields input:focus-visible, .contact-fields select:focus-visible, .contact-fields textarea:focus-visible, .contact-submit button:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 3px; }
	.contact-message, .contact-submit { grid-column: 1 / -1; }
	.contact-submit button { display: inline-flex; align-items: center; gap: 20px; padding: 14px 20px; border: 1px solid var(--gold-light); background: transparent; color: var(--text-bone); font: 10px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
	.contact-submit button:hover { background: rgba(200,169,126,.12); }
	.contact-submit button span { color: var(--gold-light); }
	.contact-submit > p { margin: 10px 0 0; color: var(--text-muted); font-size: 10px; }
	.contact-submit .contact-status:empty { display: none; }
	.contact-submit .contact-status { color: var(--gold-light); }
	.back-to-collection { display: inline-flex; align-items: center; gap: 18px; padding: 13px 0; border-bottom: 1px solid rgba(200,169,126,.65); color: var(--text-bone); font-size: 11px; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
	.back-to-collection span { color: var(--gold-light); }
	.back-to-collection:focus-visible, .breadcrumbs a:focus-visible, .detail-pagination a:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 4px; }
	.detail-pagination { display: flex; justify-content: space-between; gap: 24px; margin-top: 72px; padding-top: 22px; border-top: 1px solid var(--border-gold-subtle); }
	.detail-pagination a { display: grid; gap: 8px; color: var(--text-bone); text-decoration: none; }
	.detail-pagination a:last-child { text-align: right; }
	.detail-pagination span { color: var(--text-muted); font: 9px var(--font-mono); letter-spacing: .14em; }
	.detail-pagination strong { font: 400 18px var(--font-display); }
	.detail-pagination a:hover strong { color: var(--gold-light); }
	@media (max-width: 760px) { .product-detail { width: min(100% - 32px, 1320px); padding-top: 125px; } .detail-layout { grid-template-columns: 1fr; gap: 30px; } .detail-copy { max-width: none; } .detail-image img { max-height: none; } .contact-request { grid-template-columns: 1fr; gap: 20px; margin-top: 58px; } .detail-pagination { margin-top: 48px; } }
	@media (max-width: 520px) { .contact-fields { grid-template-columns: 1fr; } .contact-request { padding: 22px 18px; } .detail-copy h1 { font-size: clamp(42px, 13vw, 60px); } .detail-pagination { gap: 14px; } .detail-pagination strong { font-size: 16px; } }
	@media (prefers-reduced-motion: reduce) { .detail-image, .detail-copy { opacity: 1; filter: none; transform: none; transition: none; } }
</style>
