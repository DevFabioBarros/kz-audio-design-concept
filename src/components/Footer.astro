---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import KzMark from '../assets/logos/kz-mark.svg';
import rolexLogo from '../assets/logos/rolex.png';
---

<footer class="luxury-footer" transition:persist="site-footer">
	<div class="footer-wordmark brand-lockup" role="img" aria-label="KZ e Rolex — conceito visual não oficial">
		<span class="kz-mark"><KzMark aria-hidden="true" /></span>
		<span class="brand-cross" aria-hidden="true">×</span>
		<Image class="rolex-mark" src={rolexLogo} alt="" width={224} height={126} format="webp" />
	</div>

	<div class="footer-grid">
		<div class="footer-col">
			<h2 style="margin-bottom: 16px;">ESTUDO VISUAL</h2>
			<p style="font-size: 13.5px; line-height: 1.8; color: var(--text-sand); max-width: 380px;">Um estudo visual que aproxima o design acústico da KZ de uma linguagem clássica de relojoaria.</p>
		</div>
		<div class="footer-col">
			<h2>COLEÇÃO</h2>
			<ul class="footer-links-list">
				<li><a href="/catalogo">Ver as nove edições</a></li>
				<li><a href="/catalogo#colecao">Imperial Pavé</a></li>
				<li><a href="/catalogo#colecao">Mirrored 24K</a></li>
				<li><a href="/catalogo#colecao">Obsidian Stage</a></li>
			</ul>
		</div>
		<div class="footer-col">
			<h2>ATELIER</h2>
			<ul class="footer-links-list">
				<li><a href="/#hero-scroll-track">Filme da coleção</a></li>
				<li><a href="/#atelier-craft">Design &amp; materiais</a></li>
				<li><a href="/catalogo">Todas as edições</a></li>
			</ul>
		</div>
		<div class="footer-col">
			<h2>CONCIERGE PRIVÉ</h2>
			<p style="font-size: 13px; color: var(--text-sand); margin-bottom: 14px;">Explore as edições e encontre o acabamento que combina com a sua escuta.</p>
			<Button href="/catalogo" variant="outline" style="display: block; text-align: center;"><span>EXPLORAR A COLEÇÃO</span></Button>
		</div>
	</div>

	<div class="footer-bottom-bar">
		<div>CONCEITO VISUAL NÃO OFICIAL · MARCAS PERTENCEM AOS SEUS TITULARES.</div>
		<div>KZ × ROLEX · ESTUDO CONCEITUAL</div>
	</div>
	<p class="footer-author">Feito por Fábio Barros · <a href="https://github.com/DevFabioBarros" target="_blank" rel="noreferrer">GitHub @DevFabioBarros</a></p>
</footer>
