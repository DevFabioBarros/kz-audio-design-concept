---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import KzMark from '../assets/logos/kz-mark.svg';
import rolexLogo from '../assets/logos/rolex.png';
---

<header class="luxury-header" id="luxury-nav-header" transition:persist="site-header">
	<a href="/#hero-scroll-track" class="brand-logo brand-lockup" id="header-brand-logo" aria-label="KZ e Rolex — conceito visual não oficial">
		<span class="kz-mark"><KzMark aria-hidden="true" /></span>
		<span class="brand-cross" aria-hidden="true">×</span>
		<Image class="rolex-mark" src={rolexLogo} alt="" width={224} height={126} format="webp" />
	</a>

	<nav class="nav-menu" aria-label="Navegação Principal">
		<a href="/#hero-scroll-track" class="nav-link">O FILME</a>
		<a href="/#atelier-craft" class="nav-link">O ATELIÊ</a>
		<a href="/catalogo" class="nav-link">COLEÇÃO</a>
	</nav>

	<div class="header-actions">
		<Button href="/catalogo" id="btn-acquire-nav">
			<span>VER COLEÇÃO</span>
			<span aria-hidden="true">↗</span>
		</Button>
	</div>
</header>
